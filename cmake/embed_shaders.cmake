# ----------------------------------------------------------------------------
# Build-time script: cmake -DSOURCES="<a.spv;b.spv>" -DOUT=<header.hpp> -P ...
#
# Writes a self-contained header embedding each SPIR-V module as a constexpr
# std::uint8_t array under namespace cad::gen. Endianness is handled later by
# ShaderLoader.hpp (explicit byte->word copy), so this stays portable.
# ----------------------------------------------------------------------------
if(NOT DEFINED SOURCES OR NOT DEFINED OUT)
    message(FATAL_ERROR "EmbedShaders.cmake requires -DSOURCES=... -DOUT=...")
endif()

set(_content
"// ============================================================================
//  shaders_gen.hpp - AUTO-GENERATED by cmake/EmbedShaders.cmake - DO NOT EDIT
//  Each constant embeds one SPIR-V module compiled by glslc.
// ============================================================================
#pragma once
#include <cstddef>
#include <cstdint>

namespace cad::gen {
")

foreach(_spv IN LISTS SOURCES)
    get_filename_component(_base "${_spv}" NAME_WLE)   # e.g. "mesh_vert"
    file(READ "${_spv}" _hex HEX)
    if(_hex STREQUAL "")
        message(FATAL_ERROR "empty shader binary: ${_spv}")
    endif()
    string(REGEX REPLACE "(..)" "0x\\1," _bytes "${_hex}")
    string(APPEND _content
"inline constexpr std::uint8_t kSpv_${_base}[] = {${_bytes}};
inline constexpr std::size_t   kSpv_${_base}_size = sizeof(kSpv_${_base});
")
endforeach()

string(APPEND _content "} // namespace cad::gen
")
file(WRITE "${OUT}" "${_content}")